def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def phase8_complete(root: Path) -> bool:
    manifest = root / "experiments/summaries/phase8_final_manifest.json"
    if not manifest.exists():
        return False
    try:
        payload = json.loads(manifest.read_text(encoding="utf-8"))
        return payload.get("status") == "PHASE_8_COMPLETE"
    except Exception:
        return False


def restore_phase8_project() -> None:
    if phase8_complete(PROJECT_ROOT):
        return

    # Preferred source: the exact Phase-8 master ZIP used by the completed Phase-9 notebook.
    archives = sorted(
        INPUT_ROOT.rglob(MASTER_ARCHIVE_NAME),
        key=lambda p: (p.stat().st_size, str(p)),
    )
    if archives:
        if PROJECT_ROOT.exists():
            shutil.rmtree(PROJECT_ROOT)
        PROJECT_ROOT.mkdir(parents=True, exist_ok=True)
        shutil.unpack_archive(str(archives[-1]), extract_dir=str(PROJECT_ROOT))
        if phase8_complete(PROJECT_ROOT):
            return

    # Fallback: some Kaggle dataset versions expose the verified project tree directly.
    manifests = list(INPUT_ROOT.rglob("phase8_final_manifest.json"))
    candidates = []
    for manifest in manifests:
        try:
            root = manifest.parents[2]
            payload = json.loads(manifest.read_text(encoding="utf-8"))
            model = root / payload["model"]["path"]
            realigner = root / "data/metadata/qwen3_4b_latent_realign.pt"
            if (
                payload.get("status") == "PHASE_8_COMPLETE"
                and (root / "src").exists()
                and model.exists()
                and realigner.exists()
            ):
                candidates.append(root)
        except Exception:
            pass

    if not candidates:
        raise FileNotFoundError(
            "No verified PHASE_8_COMPLETE project was found in /kaggle/input."
        )

    source = sorted(candidates, key=lambda p: str(p))[0]
    if PROJECT_ROOT.exists():
        shutil.rmtree(PROJECT_ROOT)
    shutil.copytree(source, PROJECT_ROOT)

    if not phase8_complete(PROJECT_ROOT):
        raise RuntimeError("Restored project failed PHASE_8_COMPLETE verification.")


