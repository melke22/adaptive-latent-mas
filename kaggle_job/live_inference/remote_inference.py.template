)


@torch.inference_mode()
def continue_latent_rollout(base_rollout: LatentRollout, extra_steps: int) -> LatentRollout:
    if extra_steps < 1:
        raise ValueError("extra_steps must be >= 1")

    past = base_rollout.past_key_values
    previous_hidden = base_rollout.last_hidden_state
    traces = list(base_rollout.traces)
    start_step = int(base_rollout.latent_steps)

    if torch.cuda.is_available():
        torch.cuda.synchronize()
    started = time.perf_counter()

    for offset in range(1, int(extra_steps) + 1):
        latent_vector = realigner(previous_hidden)
        latent_embedding = latent_vector.unsqueeze(1)

        cache_len = past_length(past)
        attention_mask = torch.ones(
            (latent_embedding.shape[0], cache_len + 1),
            dtype=torch.long,
            device=latent_embedding.device,
        )

        outputs = backend.model(
            inputs_embeds=latent_embedding,
            attention_mask=attention_mask,
            past_key_values=past,
            use_cache=True,
            output_hidden_states=True,
            return_dict=True,
        )

        past = outputs.past_key_values
        current_hidden = outputs.hidden_states[-1][:, -1, :]

        distance = representation_distance(current_hidden, previous_hidden)
        logits = backend.project_hidden_to_logits(current_hidden)
        entropy = predictive_entropy(logits)

        traces.append(
            LatentStepTrace(
                step=start_step + offset,
                representation_distance=float(distance.item()),
                entropy=float(entropy.item()),
                hidden_norm=float(current_hidden.float().norm(dim=-1).item()),
            )
        )
        previous_hidden = current_hidden

    if torch.cuda.is_available():
        torch.cuda.synchronize()
    extra_latency = time.perf_counter() - started

    return LatentRollout(
        past_key_values=past,
        last_hidden_state=previous_hidden,
        prompt_tokens=int(base_rollout.prompt_tokens),
        latent_steps=start_step + int(extra_steps),
        latency_seconds=float(base_rollout.latency_seconds + extra_latency),
        initial_cache_length=int(base_rollout.initial_cache_length),
        final_cache_length=int(past_length(past)),
        traces=traces,
    )


def signals_first10(rollout: LatentRollout):
    if len(rollout.traces) < 10:
        raise RuntimeError("Controller requires ten latent traces.")
    return [
        {
            "step": int(trace.step),
            "representation_distance": float(trace.representation_distance),
            "entropy": float(trace.entropy),
            "hidden_norm": float(trace.hidden_norm),
        }
        for trace in rollout.traces[:10]
    ]


def controller_decision(role: str, rollout10: LatentRollout):
    started = time.perf_counter()
    decision = adaptive_controller.decide(role, signals_first10(rollout10))
    return decision, float(time.perf_counter() - started)


def compute_tier(total_steps: int) -> str:
    if total_steps <= 30:
        return "LOW"
    if total_steps <= 50:
        return "MEDIUM"
    return "HIGH"


# Only examples already opened/evaluated in Phase 9 may be used for benchmark-fidelity checks.
# This prevents the live UI from accidentally opening the SEALED_REMAINDER.
ALLOWED_PHASE9_VERIFICATION_IDS = {
    "gsm8k": {"gsm8k_test_00198"},
    "arc_challenge": set(),
}


def validate_request(payload: dict) -> dict:
    dataset = str(payload.get("dataset", "")).strip().lower()
    if dataset not in {"gsm8k", "arc_challenge"}:
        raise ValueError("dataset must be 'gsm8k' or 'arc_challenge'.")

    benchmark_example_id = payload.get("benchmark_example_id")
    if benchmark_example_id:
        benchmark_example_id = str(benchmark_example_id).strip()

        if benchmark_example_id not in ALLOWED_PHASE9_VERIFICATION_IDS.get(dataset, set()):
            raise ValueError(
                "This benchmark ID is not in the pre-approved Phase-9 verification set. "
                "The restriction protects the sealed test remainder."
            )

        matches = [
            record
            for record in load_records(dataset, "test")
            if str(record["id"]) == benchmark_example_id
        ]
        if len(matches) != 1:
            raise RuntimeError(
                f"Could not resolve exactly one official {dataset} record for "
                f"{benchmark_example_id!r}; found {len(matches)}."
            )

        record = dict(matches[0])
        record["request_source"] = "phase9_evaluated_benchmark"
        return record

    question = str(payload.get("question", "")).strip()
    reference = payload.get("reference_answer", None)

    if not question:
        raise ValueError(
            "Custom inference requires a non-empty question, or provide benchmark_example_id."
        )

    return {
        "id": str(payload.get("id", "live_request")),
        "dataset": dataset,
        "split": "live",
        "question": question,
        "reference_answer": "" if reference is None else str(reference),
        "request_source": "custom_question",
    }


@torch.inference_mode()
def run_adaptive(record: dict) -> dict:
    wall_start = time.perf_counter()
    controller_latency = 0.0

    if torch.cuda.is_available():
        torch.cuda.reset_peak_memory_stats()

    planner_prompt = render_planner_prompt(backend, record)
    critic_prompt = render_critic_prompt(backend, record)
    solver_prompt = render_solver_prompt(backend, record)

    planner = rollout_engine.rollout(
        planner_prompt,
        latent_steps=LOW_STEPS,
        past_key_values=None,
    )
    p_decision, p_time = controller_decision("planner", planner)
    controller_latency += p_time
    if p_decision["continue_reasoning"]:
        planner = continue_latent_rollout(planner, HIGH_STEPS - LOW_STEPS)

    critic = rollout_engine.rollout(
        critic_prompt,
        latent_steps=LOW_STEPS,
        past_key_values=planner.past_key_values,
    )
    c_decision, c_time = controller_decision("critic", critic)
    controller_latency += c_time
    if c_decision["continue_reasoning"]:
        critic = continue_latent_rollout(critic, HIGH_STEPS - LOW_STEPS)

    solver = rollout_engine.rollout(
        solver_prompt,
        latent_steps=LOW_STEPS,
        past_key_values=critic.past_key_values,
    )
    s_decision, s_time = controller_decision("solver", solver)
    controller_latency += s_time
    if s_decision["continue_reasoning"]:
        solver = continue_latent_rollout(solver, HIGH_STEPS - LOW_STEPS)

    decoded = latent_decoder.generate(
        last_hidden_state=solver.last_hidden_state,
        past_key_values=solver.past_key_values,
        max_new_tokens=MAX_NEW_TOKENS,
    )

    prediction = extract_prediction(record["dataset"], decoded["text"])

    p_steps = int(planner.latent_steps)
    c_steps = int(critic.latent_steps)
    s_steps = int(solver.latent_steps)
    total_steps = p_steps + c_steps + s_steps

    reference = record.get("reference_answer", "")
    correctness = None
    if reference:
        correctness = bool(is_correct(record["dataset"], prediction, reference))

    peak_gpu_gb = (
        float(torch.cuda.max_memory_allocated() / (1024 ** 3))
        if torch.cuda.is_available()
        else None
    )

    return {
        "status": "SUCCESS",
        "mode": "LIVE_KAGGLE_GPU",
        "method": "three_agent_learned_adaptive_latent",
        "request": {
            "id": record["id"],
            "dataset": record["dataset"],
            "question": record["question"],
            "reference_answer_supplied": bool(reference),
            "source": record.get("request_source", "unknown"),
        },
        "model": {
            "id": MODEL_ID,
            "revision": MODEL_REVISION,
            "dtype": str(LATENT_DTYPE),
        },
        "controller": {
            "name": PHASE8_MANIFEST.get("selected_model", "gradient_boosting_huber"),
            "threshold": CONTROLLER_THRESHOLD,
            "sha256": sha256_file(CONTROLLER_PATH),
        },
        "prediction": prediction,
        "reference_answer": reference if reference else None,
        "correct": correctness,
        "raw_output": decoded["text"],
        "agents": {
            "planner": {
                "decision": p_decision["decision"],
                "predicted_marginal_utility": float(p_decision["predicted_marginal_utility"]),
                "latent_steps": p_steps,
                "prompt_tokens": int(planner.prompt_tokens),
                "latent_latency_seconds": float(planner.latency_seconds),
            },
            "critic": {
                "decision": c_decision["decision"],
                "predicted_marginal_utility": float(c_decision["predicted_marginal_utility"]),
                "latent_steps": c_steps,
                "prompt_tokens": int(critic.prompt_tokens),
                "latent_latency_seconds": float(critic.latency_seconds),
            },
            "solver": {
                "decision": s_decision["decision"],
                "predicted_marginal_utility": float(s_decision["predicted_marginal_utility"]),
                "latent_steps": s_steps,
                "prompt_tokens": int(solver.prompt_tokens),
                "latent_latency_seconds": float(solver.latency_seconds),
            },
        },
        "total_latent_steps": total_steps,
        "latent_step_saving_vs_fixed20_percent": float(100.0 * (60 - total_steps) / 60.0),
        "compute_tier": compute_tier(total_steps),
        "generated_tokens": int(decoded["generated_tokens"]),
        "intermediate_generated_tokens": 0,
        "decode_prompt_tokens": int(decoded["decode_prompt_tokens"]),
        "prompt_tokens_total": int(
            planner.prompt_tokens + critic.prompt_tokens + solver.prompt_tokens
        ),
        "controller_latency_seconds": float(controller_latency),
        "decode_latency_seconds": float(decoded["latency_seconds"]),
        "model_component_latency_seconds": float(
            planner.latency_seconds
            + critic.latency_seconds
            + solver.latency_seconds
            + decoded["latency_seconds"]
        ),
        "wall_latency_seconds": float(time.perf_counter() - wall_start),
        "peak_gpu_memory_gb": peak_gpu_gb,
        "decoder_transition": decoded["transition"],
        "true_10_to_20_continuation": True,
        "intermediate_text_generated": False,
    }


